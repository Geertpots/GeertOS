# Kopieer dit bestand naar secrets.toml en kies zelf een sterke toegangscode.
# secrets.toml wordt door .gitignore nooit naar GitHub gestuurd.
GEERTOS_ACCESS_CODE = "vervang-dit-door-een-sterke-eigen-code"

# Alleen voor Sprint 8A cloudgebruik. Laat deze regel lokaal weg om de
# bestaande Sprint 7 SQLite-database te blijven gebruiken.
GEERTOS_DATABASE_URL = "postgresql://gebruiker:wachtwoord@host:6543/postgres?sslmode=require"
